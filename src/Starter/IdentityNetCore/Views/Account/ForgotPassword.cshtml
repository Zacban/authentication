@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_UnauthenticatedLayout";
}

<div class="auth-card">
    <h2 class="mb-1">Reset your password</h2>
    <p class="text-muted mb-4">Enter the email address associated with your account and we'll send a reset link.</p>

    <form asp-controller="Account" asp-action="ForgotPassword" method="post">
        <div class="mb-4">
            <label class="form-label">Email address</label>
            <input type="email" name="Email" class="form-control form-control-lg" placeholder="name@example.com"
                   required />
        </div>
        <button type="submit" class="btn btn-primary btn-lg w-100 mb-3">Send Reset Link</button>
    </form>

    <div class="text-center">
        <a asp-controller="Account" asp-action="Login" class="small text-decoration-none">&larr; Back to Sign In</a>
    </div>
</div>