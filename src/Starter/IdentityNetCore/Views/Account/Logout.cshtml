@{
    ViewData["Title"] = "Signed Out";
    Layout = "_UnauthenticatedLayout";
}

<div class="auth-card text-center">
    <div class="mb-3" style="font-size: 3rem;">&#x1F44B;</div>
    <h2 class="mb-2">You've been signed out</h2>
    <p class="text-muted mb-4">Thank you for using Identity Portal. Your session has ended.</p>
    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg w-100">Sign In Again</a>
</div>