@model IdentityNetCore.Models.LoginWith2faViewModel
@{
    ViewData["Title"] = "Two-Factor Verification";
    Layout = "_UnauthenticatedLayout";
}

<div class="auth-card">
    <h2 class="mb-1">Two-Factor Verification</h2>
    <p class="text-muted mb-4">Enter the 6-digit code from your authenticator app.</p>

    <form asp-controller="Account" asp-action="LoginWith2fa" method="post">
        @Html.ValidationSummary(false, "", new { @class = "text-danger mb-3" })

        <div class="mb-3">
            <label asp-for="TwoFactorCode" class="form-label"></label>
            <input asp-for="TwoFactorCode" class="form-control form-control-lg" autocomplete="one-time-code"
                   placeholder="123 456" />
            <span asp-validation-for="TwoFactorCode" class="text-danger small"></span>
        </div>

        <input type="hidden" asp-for="RememberMe" />

        <button type="submit" class="btn btn-primary btn-lg w-100 mb-3">Verify &amp; Sign In</button>
    </form>

    <div class="text-center mt-3">
        <a asp-controller="Account" asp-action="Login" class="small text-decoration-none">Back to sign in</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
